PORT=3000
NODE_ENV="development"
JWT_SECRET=nusatrip-super-secret-key-change-me
JWT_EXPIRE=1d

# Used by Docker Compose to initialize the PostgreSQL container.
POSTGRES_DB=nusatrip
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_PORT=5432

# Use host `postgres` when the backend runs inside Docker Compose.
DATABASE_URL="postgresql://postgres:postgres_password@postgres:5432/nusatrip"

R2_ACCOUNT_ID=cloudflare_account_id
R2_ACCESS_KEY_ID=r2_access_key
R2_SECRET_ACCESS_KEY=r2_secret_key
R2_BUCKET_NAME=bucket_name